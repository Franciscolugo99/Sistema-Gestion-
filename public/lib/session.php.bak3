<?php
// public/lib/session.php
declare(strict_types=1);

if (!function_exists('flus_detect_root')) {
  /**
   * Detecta el root del proyecto de forma robusta, incluso si todavía no existe src/config.php
   *
   * Estructura típica:
   *   root/public/lib/session.php  -> root = dirname(__DIR__, 2)
   *
   * Estructura alternativa (packaging):
   *   root/app/public/lib/session.php -> root/app = dirname(__DIR__, 3)
   */
  function flus_detect_root(): string {
    // __DIR__ = .../public/lib
    $publicDir = dirname(__DIR__, 1);      // .../public
    $rootDir   = dirname(__DIR__, 2);      // .../ (root del proyecto típico)
    $maybeApp  = dirname(__DIR__, 3);      // .../ (para caso root/app)

    $candidates = [
      $rootDir,                // típico
      $maybeApp,               // caso root/app/public
      dirname($rootDir),       // fallback
      $publicDir,              // último recurso
      dirname($publicDir),     // último último
    ];

    foreach ($candidates as $r) {
      if (!$r) continue;

      // Detectar aunque falte config.php (para permitir install.php)
      if (is_file($r . '/src/config.php')) return $r;
      if (is_file($r . '/src/config.example.php')) return $r;
      if (is_file($r . '/public/bootstrap.php')) return $r;
    }

    // fallback: rootDir (mejor que subir a htdocs por error)
    return $rootDir;
  }
}

if (!defined('FLUS_ROOT')) {
  define('FLUS_ROOT', flus_detect_root());
}

if (!function_exists('flus_session_start')) {
  function flus_session_start(): void {
    if (session_status() === PHP_SESSION_ACTIVE) return;

    // Session save_path (portable-friendly)
    $tmp1 = FLUS_ROOT . '/stack/tmp';
    $tmp2 = FLUS_ROOT . '/tmp';
    $savePath = is_dir($tmp1) ? $tmp1 : (is_dir($tmp2) ? $tmp2 : '');

    if ($savePath !== '') {
      @ini_set('session.save_path', $savePath);
    }

    $isHttps = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off')
      || (($_SERVER['SERVER_PORT'] ?? '') == 443);

    if (PHP_VERSION_ID >= 70300) {
      session_set_cookie_params([
        'lifetime' => 0,
        'path' => '/',
        'httponly' => true,
        'samesite' => 'Lax',
        'secure' => $isHttps,
      ]);
    } else {
      session_set_cookie_params(0, '/; samesite=Lax', '', $isHttps, true);
    }

    session_start();
  }
}
