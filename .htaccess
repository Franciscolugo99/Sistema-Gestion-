# FLUS - Seguridad + DocumentRoot friendly
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Bloqueo directo de carpetas sensibles si el proyecto se expone desde la raíz
  RewriteRule ^(?:src|storage|scripts|views)(?:/|$) - [F,L]

  # ✅ Evitar loops: si ya estás pidiendo /public/... NO reescribas
  RewriteRule ^public(?:/|$) - [L]

  # Si existe archivo/carpeta real en /kiosco, servilo
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Enviar todo lo demás a /public
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Bloqueo de archivos sensibles por extensión
<FilesMatch "(?i)\.(sql|sqlite|sqlite3|bak|zip|rar|7z|env|log|ini)$">
  Require all denied
</FilesMatch>
