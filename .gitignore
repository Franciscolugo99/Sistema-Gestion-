# =========================================================
# FLUS / Kiosco - .gitignore (XAMPP + PHP)

# -------------------------
# Sistema / editor
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
.vscode/
.idea/
# Logs / temporales
*.log
*.tmp
tmp/
cache/
logs/
# Dependencias
/vendor/          # Composer
/node_modules/    # Node
# Variables de entorno / secretos
.env
.env.*
*.key
*.pem
*.csr
*.pfx
# Si tenés un config local con credenciales, descomentá:
# /src/config.php
# Backups / dumps / exports
*.sql
*.sqlite
*.sqlite3
*.zip
*.rar
*.7z
*.bak
# Storage del sistema (NO subir datos)
/storage/logs/
/storage/backups/
# Mantener carpeta storage en repo (creá storage/.gitkeep)
/storage/.gitkeep
# Permitir el .htaccess dentro de storage
!/storage/.htaccess
# Uploads (si son archivos subidos por usuarios)
/public/uploads/
# Imágenes de productos (subidas por usuario)
/public/img/productos/
!/public/img/productos/.gitkeep
/uploads/
# Si querés versionar un .gitkeep dentro de uploads (opcional):
# !/public/uploads/.gitkeep
# !/uploads/.gitkeep
# Archivos locales / notas
*.local
*.local.*
/src/config.php
/src/config_arca.php
public/_debug_dashboard_schema.php
codigo_completo.txt
d
public/img/*
!public/img/.htaccess
!public/img/.gitkeep
public/img/productos/*
!public/img/productos/.htaccess
!public/img/productos/.gitkeep
# Backups locales
*.bak_*
public/_csrf_token.php
*.bak3
qa!
# --- FLUS: caches locales ---
public/api/actions/.productos_schema_cache.json
# --- FLUS: vendor local (opcional; dejar fuera por defecto) ---
public/assets/vendor/
# Logs/cache típicos
storage/logs/
storage/cache/
*.backup
# --- backups / temporales ---
*~
*.old
storage/restore.lock
snippets/
# FLUS local
/backups-csrf/
/cookies.txt
/storage/license.json
NUL
# Flags locales (no commitear)
storage/audit.disabled
tools/
public/_db_check.php
tools/
FLUS_PATCH_compras_desc_item.patch
storage/license_state.json

# Estado local de licencia (no versionar)
storage/license_state.json

# local runtime state
storage/license_state.json
license.json
flus_fixes.patch
*.patch
Nuevo documento de texto.txt
storage/login_throttle/
